<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ResumeForge AI</title>
<style>
:root{--ink:#20243b;--muted:#697086;--line:#e7e8f0;--card:#fff;--bg:#fafbff;--purple:#6d5efc;--purple2:#eeeaff;--mint:#e4f6ef;--peach:#fff0e8;--pink:#ffe9f0;--blue:#e8f2ff;--shadow:0 18px 50px rgba(35,35,80,.09);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--bg)}button,input,textarea,select{font:inherit}button{cursor:pointer;border:0}.hidden{display:none!important}.container{width:min(1180px,calc(100% - 40px));margin:auto}.topbar{height:72px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:rgba(255,255,255,.9);position:sticky;top:0;z-index:10;backdrop-filter:blur(14px)}.brand{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:-.04em}.brand-mark{width:35px;height:35px;border-radius:12px;background:var(--purple);color:#fff;display:grid;place-items:center;font-weight:900;box-shadow:0 8px 20px rgba(109,94,252,.25)}.brand small{display:block;color:#8b8fa1;font-size:9px;letter-spacing:.14em;font-weight:800;margin-top:2px}.brand-name{font-size:17px}.brand-name span{color:var(--purple)}.nav{display:flex;align-items:center;gap:24px}.nav button{background:transparent;color:var(--muted);font-size:13px;font-weight:700}.nav button:hover{color:var(--purple)}.btn{border-radius:12px;padding:12px 18px;font-weight:800;font-size:13px;transition:.18s transform,.18s box-shadow}.btn:hover{transform:translateY(-1px)}.btn-primary{background:var(--purple);color:#fff;box-shadow:0 10px 22px rgba(109,94,252,.2)}.btn-light{background:#fff;color:var(--ink);border:1px solid var(--line)}.hero{padding:86px 0 70px;background:linear-gradient(135deg,#fff 0%,#f5f3ff 56%,#fff 100%)}.hero-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:70px}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.18em;color:var(--purple);font-weight:900}.hero h1{font-size:clamp(44px,6vw,76px);line-height:.98;letter-spacing:-.07em;margin:16px 0 22px;max-width:620px}.hero h1 span{color:var(--purple)}.hero p{font-size:17px;line-height:1.7;color:var(--muted);max-width:550px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.people{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px;margin-top:24px}.avatars{display:flex}.avatar{height:26px;width:26px;border-radius:50%;border:2px solid #fff;margin-right:-6px;display:grid;place-items:center;font-size:9px;font-weight:900}.a1{background:#ffc7b7}.a2{background:#d8cdfc}.a3{background:#bfe9d6}.hero-art{position:relative}.mock{background:var(--ink);border-radius:22px;padding:15px;box-shadow:var(--shadow);transform:rotate(2deg)}.mock-window{background:#fff;border-radius:13px;overflow:hidden}.mock-head{height:35px;background:#f4f3fa;display:flex;align-items:center;gap:5px;padding:0 14px}.dot{width:7px;height:7px;border-radius:50%;background:#ff9a8d}.dot:nth-child(2){background:#ffd36b}.dot:nth-child(3){background:#8ddbb1}.mock-body{display:grid;grid-template-columns:115px 1fr;min-height:315px}.mock-side{background:#262a43;color:#fff;padding:18px 12px;font-size:9px}.mock-side strong{font-size:11px;display:block;margin-bottom:28px}.mock-side div{padding:9px 6px;color:#b8bad0}.mock-side div:first-of-type{background:#423b72;border-radius:6px;color:#fff}.mock-main{padding:20px}.mock-main small{color:#8c8ea0;font-size:9px}.mock-main h3{font-size:19px;margin:9px 0 17px}.mini-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mini-stat{border:1px solid var(--line);border-radius:9px;padding:9px}.mini-stat b{font-size:17px;display:block}.mini-stat span{font-size:8px;color:var(--muted)}.chart{height:105px;margin-top:16px;border:1px solid var(--line);border-radius:9px;padding:12px;display:flex;align-items:end;gap:8px}.bar{flex:1;background:#d8d1ff;border-radius:4px 4px 0 0}.bar:nth-child(2),.bar:nth-child(5){background:var(--purple)}.score{position:absolute;right:-18px;top:42px;background:#fff;padding:15px 18px;border-radius:14px;box-shadow:var(--shadow);font-size:13px;font-weight:900}.score span{color:#19a56f}.section{padding:88px 0}.section h2{font-size:clamp(32px,4vw,52px);letter-spacing:-.06em;margin:13px 0}.section-intro{color:var(--muted);line-height:1.7;max-width:620px}.feature-grid,.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:40px}.feature,.price{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:25px;box-shadow:0 8px 28px rgba(35,35,80,.035)}.feature-icon{height:44px;width:44px;border-radius:14px;display:grid;place-items:center;font-size:21px}.purple{background:var(--purple2)}.mint{background:var(--mint)}.peach{background:var(--peach)}.feature h3{margin:22px 0 8px}.feature p,.price p{color:var(--muted);line-height:1.65;font-size:14px}.dark-section{background:var(--ink);color:#fff}.dark-section .section-intro{color:#b7b9cb}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;margin-top:45px}.step{border-top:1px solid rgba(255,255,255,.2);padding-top:18px}.step-number{color:#a99fff;font-family:monospace}.step h3{margin-top:46px;font-size:22px}.price-grid{grid-template-columns:repeat(2,1fr);max-width:760px}.price strong{font-size:42px;display:block;margin:18px 0}.price ul{padding:0;list-style:none;color:var(--muted);line-height:2.2;font-size:14px}.price li:before{content:'✓';color:#19a56f;font-weight:900;margin-right:9px}.price.highlight{border:2px solid var(--purple);background:#f6f4ff}.faq{max-width:760px;margin:35px auto 0}.faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:17px 20px;margin:10px 0}.faq summary{font-weight:800;cursor:pointer}.faq p{color:var(--muted);line-height:1.6;font-size:14px}.footer{border-top:1px solid var(--line);padding:35px 0;color:var(--muted);font-size:12px}.footer .container{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
/* workspace */
.workspace{min-height:100vh;display:grid;grid-template-columns:255px 1fr;background:#f8f9fd}.sidebar{background:#fff;border-right:1px solid var(--line);padding:18px 16px;display:flex;flex-direction:column}.side-nav{margin-top:35px;display:grid;gap:4px}.side-nav button{background:transparent;text-align:left;border-radius:12px;padding:12px;color:var(--muted);font-weight:700;font-size:13px}.side-nav button:hover,.side-nav button.active{background:var(--purple2);color:var(--purple)}.side-bottom{margin-top:auto}.copilot-card{background:var(--ink);color:#fff;border-radius:17px;padding:16px;margin-bottom:15px}.copilot-card p{color:#b9bbcc;font-size:11px;line-height:1.6}.workspace-main{min-width:0}.workspace-head{height:72px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 30px}.workspace-head h2{font-size:19px;margin:4px 0}.workspace-head small{color:var(--muted)}.head-actions{display:flex;align-items:center;gap:14px}.search{border:1px solid var(--line);border-radius:24px;padding:10px 14px;color:var(--muted);font-size:13px;min-width:210px}.workspace-content{padding:32px}.welcome{display:flex;justify-content:space-between;align-items:end;gap:20px}.welcome h1{font-size:38px;letter-spacing:-.06em;margin:8px 0}.welcome p{color:var(--muted);margin:0}.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:13px;margin:32px 0 20px}.stat,.panel{background:#fff;border:1px solid var(--line);border-radius:17px;padding:17px}.stat-icon{height:31px;width:31px;border-radius:10px;display:grid;place-items:center}.stat b{font-size:27px;display:block;margin-top:20px}.stat span{font-size:12px;color:var(--muted)}.dashboard-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:20px}.panel h3{margin:0}.panel-sub{color:var(--muted);font-size:12px;margin-top:5px}.empty{min-height:185px;display:grid;place-items:center;text-align:center;color:var(--muted);font-size:13px}.empty strong{color:var(--ink);display:block;margin-bottom:8px}.progress{margin-top:22px}.progress label{display:flex;justify-content:space-between;font-size:12px;font-weight:800;margin-top:16px}.track{height:8px;background:#eff0f5;border-radius:10px;margin-top:8px;overflow:hidden}.track i{display:block;height:100%;border-radius:10px;background:var(--purple)}.track.mint i{background:#19b67c}.track.orange i{background:#ff7b21}.workspace-view{display:none}.workspace-view.active{display:block}.cards-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:25px}.resume-card{background:#fff;border:1px solid var(--line);border-radius:17px;padding:15px}.resume-preview{height:145px;border-radius:11px;background:#f4f3fa;padding:14px}.resume-preview b{display:block;width:80px;height:7px;background:var(--purple);border-radius:8px}.resume-preview i{display:block;height:5px;background:#dcdde8;border-radius:8px;margin-top:12px;width:80%}.resume-preview i:nth-child(3){width:60%}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:20px}.field label{font-size:12px;font-weight:800;display:block;margin-bottom:7px}.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);border-radius:10px;padding:11px;background:#fff;outline:none}.field textarea{min-height:120px;resize:vertical}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.toast{position:fixed;right:22px;bottom:22px;background:var(--ink);color:#fff;padding:13px 17px;border-radius:12px;box-shadow:var(--shadow);font-size:13px;z-index:20}.modal-backdrop{position:fixed;inset:0;background:rgba(20,22,38,.45);display:grid;place-items:center;z-index:30;padding:20px}.modal{background:#fff;width:min(430px,100%);border-radius:20px;padding:25px;box-shadow:var(--shadow)}.modal h2{margin-top:0}.modal p{color:var(--muted);font-size:13px;line-height:1.6}.modal input{width:100%;padding:12px;border:1px solid var(--line);border-radius:10px;margin:10px 0 17px}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:45px}.hero-art{max-width:650px;margin:auto}.feature-grid,.steps{grid-template-columns:1fr}.workspace{display:block}.sidebar{display:none}.workspace-head{padding:0 17px}.workspace-content{padding:22px 16px}.stats{grid-template-columns:repeat(2,1fr)}.dashboard-grid{grid-template-columns:1fr}.cards-grid{grid-template-columns:1fr 1fr}.search{display:none}.side-mobile{display:block}}
@media(max-width:600px){.container{width:min(100% - 28px,1180px)}.nav button:not(.btn){display:none}.hero{padding:58px 0}.hero h1{font-size:48px}.mock-body{grid-template-columns:82px 1fr}.mock-side{padding:12px 8px}.mock-main{padding:13px}.mini-stats{gap:4px}.mini-stat{padding:6px}.mini-stat b{font-size:13px}.score{right:-5px;top:20px}.section{padding:62px 0}.price-grid{grid-template-columns:1fr}.stats{gap:9px}.stat{padding:13px}.stat b{font-size:24px}.welcome{align-items:start;flex-direction:column}.welcome h1{font-size:31px}.form-grid{grid-template-columns:1fr}.cards-grid{grid-template-columns:1fr}.workspace-head{height:64px}.workspace-head h2{font-size:17px}.workspace-content{padding-top:25px}}
</style>
</head>
<body>
<div id="app"></div>
<div id="toast" class="toast hidden"></div>
<div id="modal" class="modal-backdrop hidden"><div class="modal"><div class="toolbar"><h2>Start your workspace</h2><button class="btn btn-light" onclick="closeModal()">×</button></div><p>Enter a name for this local demo. It is stored only in this browser and is never sent anywhere.</p><input id="nameInput" placeholder="Your name" autocomplete="name"><button class="btn btn-primary" style="width:100%" onclick="enterWorkspace()">Enter workspace</button></div></div>
<script>
const templates=[['Modern','Popular','#6d5efc'],['Minimal','Editorial','#19a67c'],['Executive','Leadership','#ec7858'],['Technical','Scannable','#4c82e8']];
let state={view:'overview',name:localStorage.getItem('rf_name')||''};
function brand(){return `<div class="brand"><div class="brand-mark">✦</div><div><div class="brand-name">ResumeForge<span>AI</span></div><small>CAREER WORKSPACE</small></div></div>`}
function toast(msg){const el=document.getElementById('toast');el.textContent=msg;el.classList.remove('hidden');clearTimeout(window.__toast);window.__toast=setTimeout(()=>el.classList.add('hidden'),2600)}
function openModal(){document.getElementById('modal').classList.remove('hidden');setTimeout(()=>document.getElementById('nameInput').focus(),50)}function closeModal(){document.getElementById('modal').classList.add('hidden')}
function enterWorkspace(){const n=document.getElementById('nameInput').value.trim()||'Your Name';state.name=n;localStorage.setItem('rf_name',n);closeModal();renderWorkspace()}
function scrollToId(id){document.getElementById(id)?.scrollIntoView({behavior:'smooth'})}
function landing(){return `<div class="topbar"><div class="container" style="display:flex;justify-content:space-between;align-items:center;width:100%">${brand()}<div class="nav"><button onclick="scrollToId('features')">Features</button><button onclick="scrollToId('templates')">Templates</button><button onclick="scrollToId('how')">How it works</button><button onclick="scrollToId('pricing')">Pricing</button><button onclick="scrollToId('faq')">FAQ</button><button onclick="openModal()">Log in</button><button class="btn btn-primary" onclick="openModal()">Get started</button></div></div></div><main>
<section class="hero"><div class="container hero-grid"><div><div class="eyebrow">The smarter way to move your career forward</div><h1>Build a resume that <span>gets noticed.</span></h1><p>Create a polished resume, tailor it to every opportunity, and turn job searching into a clear, confident workflow—with AI that never makes up your story.</p><div class="actions"><button class="btn btn-primary" onclick="openModal()">Create my resume →</button><button class="btn btn-light" onclick="scrollToId('templates')">Explore templates</button></div><div class="people"><div class="avatars"><i class="avatar a1">JD</i><i class="avatar a2">MK</i><i class="avatar a3">RS</i></div>Join 12,000+ ambitious candidates</div></div><div class="hero-art"><div class="mock"><div class="mock-window"><div class="mock-head"><i class="dot"></i><i class="dot"></i><i class="dot"></i></div><div class="mock-body"><div class="mock-side"><strong>ResumeForge</strong><div>Overview</div><div>My resumes</div><div>AI builder</div><div>Job matcher</div><div>Applications</div></div><div class="mock-main"><small>TUESDAY, 23 SEPTEMBER</small><h3>Good morning, Alex</h3><div class="mini-stats"><div class="mini-stat"><b>18</b><span>Applications</span></div><div class="mini-stat"><b>04</b><span>Interviews</span></div><div class="mini-stat"><b>82%</b><span>Match score</span></div></div><div class="chart"><i class="bar" style="height:25%"></i><i class="bar" style="height:38%"></i><i class="bar" style="height:33%"></i><i class="bar" style="height:60%"></i><i class="bar" style="height:74%"></i><i class="bar" style="height:90%"></i><i class="bar" style="height:82%"></i></div></div></div></div></div><div class="score"><span>↗ +24%</span> match score<br><small style="color:var(--muted);font-weight:500">After one smart edit</small></div></div></div></section>
<section class="section" id="features"><div class="container"><div class="eyebrow">A calmer career workflow</div><h2>Everything you need to turn effort into momentum.</h2><p class="section-intro">One focused workspace for the moments that matter—from your first draft to the offer conversation.</p><div class="feature-grid"><div class="feature"><div class="feature-icon purple">✦</div><h3>Write with integrity</h3><p>Polish your real experience with grounded AI suggestions that never invent credentials, metrics, or employment history.</p></div><div class="feature"><div class="feature-icon mint">◎</div><h3>Match with confidence</h3><p>See the skills, language, and responsibilities that connect your resume to a role.</p></div><div class="feature"><div class="feature-icon peach">↗</div><h3>Track every opportunity</h3><p>Keep applications, reminders, interviews, and follow-ups in one clear view.</p></div></div></div></section>
<section class="section dark-section" id="how"><div class="container"><div class="eyebrow" style="color:#a99fff">How it works</div><h2>A better next step, every time.</h2><p class="section-intro">No black-box scoring. No mystery edits. Just practical guidance that stays close to your story.</p><div class="steps"><div class="step"><div class="step-number">01</div><h3>Capture</h3><p class="section-intro">Start with what you’ve already done.</p></div><div class="step"><div class="step-number">02</div><h3>Sharpen</h3><p class="section-intro">Use AI to make your impact easier to see.</p></div><div class="step"><div class="step-number">03</div><h3>Move</h3><p class="section-intro">Tailor, apply, prepare, and follow through.</p></div></div></div></section>
<section class="section" id="templates"><div class="container"><div class="toolbar"><div><div class="eyebrow">Template gallery</div><h2>Your story, in the right shape.</h2></div><button class="btn btn-light" onclick="openModal()">View all templates</button></div><div class="feature-grid">${templates.map(t=>`<div class="feature"><div class="resume-preview"><b style="background:${t[2]}"></b><i></i><i></i><i style="width:70%"></i></div><h3>${t[0]}</h3><p>${t[1]} structure for a confident read.</p><button class="btn btn-light" onclick="openModal()">Use template →</button></div>`).join('')}</div></div></section>
<section class="section" id="pricing"><div class="container"><div class="eyebrow">Simple pricing</div><h2>Start free. Grow into your next chapter.</h2><p class="section-intro">Everything you need to build a strong foundation—without a credit card.</p><div class="feature-grid price-grid"><div class="price"><h3>Starter</h3><strong>$0 <small style="font-size:14px;color:var(--muted)">/ month</small></strong><p>For getting your core story in shape.</p><ul><li>1 resume workspace</li><li>ATS health check</li><li>5 AI suggestions / month</li><li>Application tracker</li></ul><button class="btn btn-light" onclick="openModal()">Choose Starter</button></div><div class="price highlight"><h3>Momentum</h3><strong>$12 <small style="font-size:14px;color:var(--muted)">/ month</small></strong><p>For an active, focused job search.</p><ul><li>Unlimited resume versions</li><li>Unlimited tailored edits</li><li>Interview prep workspace</li><li>Priority AI assistance</li></ul><button class="btn btn-primary" onclick="openModal()">Choose Momentum</button></div></div></div></section>
<section class="section" id="faq"><div class="container"><div style="text-align:center"><div class="eyebrow">Questions, answered</div><h2>You’re in good company.</h2></div><div class="faq"><details><summary>Will AI make up experience?</summary><p>No. ResumeForge AI is designed to transform the information you provide, not invent qualifications, metrics, or employment history.</p></details><details><summary>Can I tailor one resume for multiple roles?</summary><p>Yes. Duplicate a version, compare changes, and keep a separate tailored copy for each opportunity.</p></details><details><summary>Is the ATS score official?</summary><p>No. It is an estimate with practical recommendations—not an official score from any applicant tracking system.</p></details><details><summary>Can I export my documents?</summary><p>Yes. The workspace includes print-ready PDF export and editable Word-compatible downloads.</p></details></div></div></section></main><footer class="footer"><div class="container"><span>${brand()}</span><span>© 2026 ResumeForge AI · Built for your next chapter.</span><span>Privacy · Terms</span></div></footer></div>`}
function navItem(id,icon,label){return `<button class="${state.view===id?'active':''}" onclick="setView('${id}')">${icon} &nbsp; ${label}</button>`}
function renderWorkspace(){document.getElementById('app').innerHTML=`<div class="workspace"><aside class="sidebar">${brand()}<div class="side-nav">${navItem('overview','▥','Overview')}${navItem('resumes','▤','My resumes')}${navItem('builder','✦','AI resume builder')}${navItem('analyzer','✓','Resume analyzer')}${navItem('matcher','◎','Job matcher')}${navItem('cover','✈','Cover letter AI')}${navItem('interview','◌','Interview prep')}${navItem('tracker','▰','Job tracker')}${navItem('templates','♡','Templates')}${navItem('skills','⚡','Skills center')}${navItem('tools','♧','Career tools')}</div><div class="side-bottom"><div class="copilot-card"><b>✦ &nbsp;Career copilot</b><p>Need a better bullet or a prep question?</p><button class="btn btn-primary" onclick="toast('Copilot is ready for your question.')">Ask copilot →</button></div>${navItem('settings','⚙','Settings')}</div></aside><section class="workspace-main"><header class="workspace-head"><div><small>Tuesday, September 23, 2026</small><h2>${state.view==='overview'?'Overview':labelFor(state.view)}</h2></div><div class="head-actions"><div class="search">⌕ &nbsp; Search workspace</div><button class="btn btn-light" onclick="renderLanding()">Log out</button><div class="avatar a2" style="height:35px;width:35px;margin:0">${initials(state.name)}</div></div></header><main class="workspace-content">${workspaceView()}</main></section></div>`}
function initials(n){return n.split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase()||'YN'}function labelFor(v){return {resumes:'My resumes',builder:'AI resume builder',analyzer:'Resume analyzer',matcher:'Job matcher',cover:'Cover letter AI',interview:'Interview prep',tracker:'Job tracker',templates:'Templates',skills:'Skills center',tools:'Career tools',settings:'Settings'}[v]||'Overview'}
function setView(v){state.view=v;renderWorkspace()}
function workspaceView(){if(state.view==='overview')return `<div class="workspace-view active"><div class="welcome"><div><div class="eyebrow">Your career command center</div><h1>Good morning, ${state.name.split(' ')[0]||'there'}.</h1><p>Small, consistent improvements compound into a stronger search.</p></div><button class="btn btn-primary" onclick="setView('builder')">＋ Create resume</button></div><div class="stats"><div class="stat"><div class="stat-icon purple">▤</div><b>0</b><span>Total resumes</span></div><div class="stat"><div class="stat-icon mint">✈</div><b>0</b><span>Applications</span></div><div class="stat"><div class="stat-icon peach">◌</div><b>0</b><span>Interviews</span></div><div class="stat"><div class="stat-icon" style="background:var(--pink)">♡</div><b>0</b><span>Saved jobs</span></div><div class="stat"><div class="stat-icon" style="background:var(--blue)">↗</div><b>78/100</b><span>Resume score</span></div></div><div class="dashboard-grid"><div class="panel"><h3>Recent resumes</h3><div class="panel-sub">Keep your story ready for every room.</div><div class="empty"><div><strong>▤<br><br>Your first resume starts here</strong>Create a base resume, then tailor versions for the roles you want.<br><br><button class="btn btn-primary" onclick="setView('builder')">Create resume</button></div></div></div><div class="panel"><h3>Resume health</h3><div class="panel-sub">A quick read on your baseline.</div><div style="font-size:32px;font-weight:900;margin-top:25px;color:var(--purple)">78</div><div class="progress"><label><span>Completeness</span><span>92%</span></label><div class="track"><i style="width:92%"></i></div><label><span>Readability</span><span style="color:#19a67c">86%</span></label><div class="track mint"><i style="width:86%"></i></div><label><span>Keyword alignment</span><span style="color:#ff7b21">71%</span></label><div class="track orange"><i style="width:71%"></i></div></div></div></div></div>`;if(state.view==='resumes'||state.view==='templates')return `<div class="toolbar"><div><div class="eyebrow">Your versions</div><h1 style="font-size:34px;margin:7px 0">${labelFor(state.view)}</h1><p style="color:var(--muted)">One strong foundation, tailored for the roles ahead.</p></div><button class="btn btn-primary" onclick="setView('builder')">＋ Create resume</button></div><div class="cards-grid">${templates.map(t=>`<div class="resume-card"><div class="resume-preview"><b style="background:${t[2]}"></b><i></i><i></i><i style="width:65%"></i></div><h3>${t[0]} resume</h3><p style="font-size:12px;color:var(--muted)">${t[1]} template · Updated today</p><button class="btn btn-primary" onclick="setView('builder')">Edit resume</button></div>`).join('')}</div>`;if(state.view==='builder')return `<div class="panel"><div class="toolbar"><div><div class="eyebrow">Build with integrity</div><h1 style="font-size:34px;margin:7px 0">AI resume builder</h1><p style="color:var(--muted)">Add your real experience, then improve clarity without inventing facts.</p></div><button class="btn btn-primary" onclick="toast('Resume saved locally in this demo.')">Save resume</button></div><div class="form-grid"><div class="field"><label>Full name</label><input placeholder="Your full name"></div><div class="field"><label>Target role</label><input placeholder="Product designer"></div><div class="field" style="grid-column:1/-1"><label>Professional summary</label><textarea placeholder="Write a concise summary based on your real experience..."></textarea></div><div class="field" style="grid-column:1/-1"><label>Experience</label><textarea placeholder="Company, role, dates, and outcome-focused bullets..."></textarea></div></div></div>`;if(state.view==='analyzer')return toolView('Resume analyzer','Paste your resume content and get a practical completeness, readability, and keyword review.','Analyze resume');if(state.view==='matcher')return toolView('Job matcher','Paste a job description to compare its language with your resume and find the strongest alignment opportunities.','Match to job');if(state.view==='cover')return toolView('Cover letter AI','Share the role, company, and your verified experience. Generate a grounded first draft you can review.','Draft cover letter');if(state.view==='interview')return toolView('Interview prep','Enter a target role to generate thoughtful questions and practice answers using the STAR method.','Generate practice set');if(state.view==='tracker')return trackerView();if(state.view==='skills')return toolView('Skills center','Keep a living list of the tools and strengths you want to bring into your next role.','Add skill');if(state.view==='tools')return toolView('Career tools','Create a professional bio, achievement bullet, follow-up email, or other practical starting point.','Generate output');if(state.view==='settings')return `<div class="panel"><div class="eyebrow">Your workspace, your rules</div><h1 style="font-size:34px;margin:7px 0">Profile & settings</h1><p style="color:var(--muted)">Personalize the workspace around the role and search you are building toward.</p><div class="form-grid"><div class="field"><label>Name</label><input value="${state.name}"></div><div class="field"><label>Email</label><input placeholder="you@example.com"></div><div class="field"><label>Career stage</label><input placeholder="Exploring / growing / leading"></div><div class="field"><label>Target role</label><input placeholder="The role you want next"></div></div><br><button class="btn btn-primary" onclick="toast('Settings saved in this browser.')">Save settings</button></div>`;return toolView(labelFor(state.view),'Your focused workspace for the next step in your career search.','Get started')}
function toolView(title,desc,action){return `<div class="panel" style="max-width:850px"><div class="eyebrow">Practical support</div><h1 style="font-size:34px;margin:7px 0">${title}</h1><p style="color:var(--muted);line-height:1.7">${desc}</p><div class="field" style="margin-top:25px"><label>Your context</label><textarea placeholder="Share the facts, role, or content you want to work with..."></textarea></div><button class="btn btn-primary" style="margin-top:16px" onclick="toast('${action} created. Review the draft before using it.')">✦ ${action}</button></div>`}
function trackerView(){return `<div class="toolbar"><div><div class="eyebrow">Stay in motion</div><h1 style="font-size:34px;margin:7px 0">Job tracker</h1><p style="color:var(--muted)">Keep applications, reminders, and follow-ups in one place.</p></div><button class="btn btn-primary" onclick="toast('Application form opened.')">＋ Add application</button></div><div class="panel" style="margin-top:25px"><div class="empty"><div><strong>▰<br><br>No applications yet</strong>Save a role to start building momentum.<br><br><button class="btn btn-primary" onclick="toast('Application form opened.')">Add application</button></div></div></div>`}
function renderLanding(){state.view='overview';document.getElementById('app').innerHTML=landing()}
renderLanding();
</script>
</body>
</html>
